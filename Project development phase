    return templates.TemplateResponse(
        "party_planner.html",
        {
            "request": request
        }
    )


@router.post("/generate-party", response_class=HTMLResponse)
async def generate_party(
    request: Request,
    budget: float = Form(...),
    guests: int = Form(...),
    event_type: str = Form(...),
    venue: str = Form(...)
):

    recommendation = get_party_recommendations(
        budget,
        guests,
        event_type,
        venue
    )

    return templates.TemplateResponse(
        "party_recommendations.html",
        {
            "request": request,
            "recommendation": recommendation,
            "budget": budget,
            "guests": guests,
            "event_type": event_type
        }
    )
