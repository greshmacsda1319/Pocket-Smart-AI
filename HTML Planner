<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <title>Party Planner</title>

    <link rel="stylesheet"
          href="/static/style.css">

</head>

<body>

<div class="container">

    <h1>Party Budget Planner</h1>

    <form action="/generate-party"
          method="post">

        <label>Budget</label>

        <input
            type="number"
            name="budget"
            required
        >

        <label>Number of Guests</label>

        <input
            type="number"
            name="guests"
            required
        >

        <label>Event Type</label>

        <input
            type="text"
            name="event_type"
            required
        >

        <label>Venue</label>

        <input
            type="text"
            name="venue"
            required
        >

        <button type="submit">
            Generate Party Plan
        </button>

    </form>

</div>

</body>

