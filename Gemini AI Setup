import os
import google.generativeai as genai
from dotenv import load_dotenv

load_dotenv()

genai.configure(
    api_key=os.getenv("GOOGLE_API_KEY")
)

model = genai.GenerativeModel(
    "gemini-1.5-flash"
)

response = model.generate_content(
    "Explain PocketSmart AI in one sentence."
)

print(response.text)
