from pydantic import BaseModel


class HomeRequest(BaseModel):

    budget: float
    room: str
    requirements: str


class PartyRequest(BaseModel):

    budget: float
    guests: int
    event_type: str
    venue: str


class JewelryRequest(BaseModel):

    budget: float
    occasion: str
    style: str


class UserRegister(BaseModel):

    username: str
    email: str
    password: str


class UserLogin(BaseModel):

    email: str
    password: str
