static/style.css
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f7fb;
    color: #222;
}

.container {
    width: 90%;
    max-width: 700px;
    margin: 50px auto;
    padding: 30px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
}

h1 {
    text-align: center;
    margin-bottom: 25px;
}

form {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

input,
select,
textarea {
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 7px;
}

textarea {
    min-height: 120px;
}

button {
    padding: 13px;
    border: none;
    border-radius: 7px;
    background: #222;
    color: white;
    cursor: pointer;
}

button:hover {
    opacity: 0.85;
}

.recommendation-card {
    margin-top: 20px;
    padding: 20px;
    background: #f7f7f7;
    border-radius: 10px;
}

pre {
    white-space: pre-wrap;
    line-height: 1.6;
}
