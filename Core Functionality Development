import os
import google.generativeai as genai
from dotenv import load_dotenv

load_dotenv()

genai.configure(
    api_key=os.getenv("GOOGLE_API_KEY")
)


def get_gemini_response(prompt):

    model = genai.GenerativeModel(
        "gemini-1.5-flash"
    )

    response = model.generate_content(prompt)

    return response.text


def get_home_recommendations(
    budget,
    room,
    requirements
):

    prompt = f"""
You are PocketSmart AI.

Create a budget-friendly home interior plan.

Budget: ₹{budget}
Room: {room}
Requirements: {requirements}

Provide recommendations for:

1. Furniture
2. Lighting
3. Decoration
4. Other useful products

For each recommendation provide:

- Product name
- Category
- Estimated price
- Suggested platform
- Reason

Keep the estimated total within the given budget.
"""

    return get_gemini_response(prompt)


def get_party_recommendations(
    budget,
    guests,
    event_type,
    venue
):

    prompt = f"""
You are PocketSmart AI.

Create a budget-friendly party plan.

Budget: ₹{budget}
Number of Guests: {guests}
Event Type: {event_type}
Venue: {venue}

Divide the budget into:

1. Food
2. Decoration
3. Entertainment
4. Venue
5. Other expenses

Provide estimated costs and suitable recommendations.

Keep the total estimated cost within the given budget.
"""

    return get_gemini_response(prompt)


